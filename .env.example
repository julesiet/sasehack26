# Copy into apps/api/.env and apps/mobile/.env as needed.

PORT=3001
# Expo Go on a phone: pnpm start detects the LAN IP. Override if needed:
#   Mac: ipconfig getifaddr en0
#   Windows: ipconfig → IPv4 Address
#   http://<lan-ip>:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
# Speech-to-text + Kasama's voice (apps/api/.env). Key needs Speech to Text and Text to Speech.
# Without it the Senior screen asks to type and falls back to iOS speech.
ELEVENLABS_API_KEY=
# Optional. Defaults to ElevenLabs "Sarah" (warm, clear).
ELEVENLABS_VOICE_ID=
# ChatGPT planner (apps/api/.env). Without it the turn stays rules-based.
MODEL_API_KEY=
# Set to 1 for the judged 3-minute demo so ChatGPT cannot change spoken copy.
KASAMA_DEMO=
# Optional. Defaults to gpt-4o-mini.
MODEL_NAME=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
COMPOSIO_API_KEY=
# Optional. Written by `composio dev init`. Kasama sessions use senior_maria.
COMPOSIO_TEST_USER_ID=
