# Copy into apps/api/.env and apps/mobile/.env as needed.

PORT=3001
# Expo Go on a phone: http://<this-mac-lan-ip>:3001 (ipconfig getifaddr en0)
EXPO_PUBLIC_API_URL=http://localhost:3001
# Speech-to-text + Kasama's voice (apps/api/.env). Key needs Speech to Text and Text to Speech.
# Without it the Senior screen asks to type and falls back to iOS speech.
ELEVENLABS_API_KEY=
# Optional. Defaults to ElevenLabs "Sarah" (warm, clear).
ELEVENLABS_VOICE_ID=
MODEL_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
COMPOSIO_API_KEY=
# Optional. Written by `composio dev init`. Kasama sessions use senior_maria.
COMPOSIO_TEST_USER_ID=
