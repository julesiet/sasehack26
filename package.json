{
  "name": "kasama",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@kasama/api",
    "start": "turbo start --filter=@kasama/mobile",
    "start:tunnel": "pnpm --filter @kasama/mobile start:tunnel",
    "ios": "turbo ios --filter=@kasama/mobile",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "playground": "pnpm --filter @kasama/api playground"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  }
}
